{
  "name": "logixia",
  "version": "1.12.0",
  "description": "Async-first TypeScript logger: wide events / canonical log lines, OTLP OpenTelemetry export, runtime log levels, redaction, adaptive sampling, NestJS, multi-transport (file, DB, cloud), tracing & log search. A fast Winston/Pino alternative.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "default": "./dist/index.js"
    },
    "./nest": {
      "import": {
        "types": "./dist/nest.d.mts",
        "default": "./dist/nest.mjs"
      },
      "require": {
        "types": "./dist/nest.d.ts",
        "default": "./dist/nest.js"
      }
    },
    "./transports": {
      "import": {
        "types": "./dist/transports.d.mts",
        "default": "./dist/transports.mjs"
      },
      "require": {
        "types": "./dist/transports.d.ts",
        "default": "./dist/transports.js"
      }
    },
    "./search": {
      "import": {
        "types": "./dist/search.d.mts",
        "default": "./dist/search.mjs"
      },
      "require": {
        "types": "./dist/search.d.ts",
        "default": "./dist/search.js"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing.d.mts",
        "default": "./dist/testing.mjs"
      },
      "require": {
        "types": "./dist/testing.d.ts",
        "default": "./dist/testing.js"
      }
    },
    "./middleware": {
      "import": {
        "types": "./dist/middleware.d.mts",
        "default": "./dist/middleware.mjs"
      },
      "require": {
        "types": "./dist/middleware.d.ts",
        "default": "./dist/middleware.js"
      }
    },
    "./worker": {
      "import": {
        "types": "./dist/worker.d.mts",
        "default": "./dist/worker.mjs"
      },
      "require": {
        "types": "./dist/worker.d.ts",
        "default": "./dist/worker.js"
      }
    },
    "./cloudwatch": {
      "import": {
        "types": "./dist/cloudwatch.d.mts",
        "default": "./dist/cloudwatch.mjs"
      },
      "require": {
        "types": "./dist/cloudwatch.d.ts",
        "default": "./dist/cloudwatch.js"
      }
    },
    "./gcp": {
      "import": {
        "types": "./dist/gcp.d.mts",
        "default": "./dist/gcp.mjs"
      },
      "require": {
        "types": "./dist/gcp.d.ts",
        "default": "./dist/gcp.js"
      }
    },
    "./azure": {
      "import": {
        "types": "./dist/azure.d.mts",
        "default": "./dist/azure.mjs"
      },
      "require": {
        "types": "./dist/azure.d.ts",
        "default": "./dist/azure.js"
      }
    },
    "./browser": {
      "import": {
        "types": "./dist/browser.d.mts",
        "default": "./dist/browser.mjs"
      },
      "require": {
        "types": "./dist/browser.d.ts",
        "default": "./dist/browser.js"
      }
    },
    "./correlation": {
      "import": {
        "types": "./dist/correlation.d.mts",
        "default": "./dist/correlation.mjs"
      },
      "require": {
        "types": "./dist/correlation.d.ts",
        "default": "./dist/correlation.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsdown",
    "cli:dev": "ts-node src/cli/index.ts",
    "build:watch": "tsc --watch",
    "clean": "rm -rf dist",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --coverage --ci --bail --forceExit",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "lint:check": "eslint src/",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "typecheck:examples": "tsc -p tsconfig.examples.json",
    "check": "npm run typecheck && npm run lint:check",
    "ci": "npm run typecheck && npm run lint:check && npm run test:ci",
    "validate": "npm run clean && npm run build && npm run typecheck && npm run lint:check && npm run test:coverage",
    "prepublishOnly": "npm run validate",
    "dev:basic-usage": "ts-node -P tsconfig.examples.json --transpile-only -r ./examples/register.js examples/basic-usage.ts",
    "dev:fastify": "ts-node -P tsconfig.examples.json --transpile-only -r ./examples/register.js examples/fastify-example.ts",
    "dev:hono": "ts-node -P tsconfig.examples.json --transpile-only -r ./examples/register.js examples/hono-example.ts",
    "dev:express": "ts-node -P tsconfig.examples.json --transpile-only -r ./examples/register.js examples/express-example.ts",
    "dev:nestjs": "ts-node -P tsconfig.examples.json --transpile-only -r ./examples/register.js examples/nestjs-example.ts",
    "dev:nestjs-app": "ts-node --project examples/nestjs-app/tsconfig.json -r ./examples/nestjs-app/register.js examples/nestjs-app/src/main.ts",
    "dev:custom-levels": "ts-node -P tsconfig.examples.json --transpile-only -r ./examples/register.js examples/custom-levels.ts",
    "dev:performance": "ts-node -P tsconfig.examples.json --transpile-only -r ./examples/register.js examples/performance-monitoring.ts",
    "dev:fields": "ts-node -P tsconfig.examples.json --transpile-only -r ./examples/register.js examples/field-configuration.ts",
    "dev:search": "ts-node -P tsconfig.examples.json --transpile-only -r ./examples/register.js examples/search-quickstart.ts",
    "dev:intelligent-search": "ts-node -P tsconfig.examples.json --transpile-only -r ./examples/register.js examples/intelligent-search.ts",
    "benchmark": "npm run build && node benchmarks/run.mjs",
    "check:exports": "node scripts/check-exports.mjs",
    "size": "size-limit",
    "prepare": "node -e \"if(process.env.HUSKY!=='0'&&process.env.CI!=='true'){try{require('child_process').execSync('husky install',{stdio:'inherit'})}catch(e){process.exit(0)}}\"",
    "benchmark:features": "npm run build && node benchmarks/features.mjs"
  },
